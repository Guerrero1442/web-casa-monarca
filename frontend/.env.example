# Configuración de Entorno - Frontend Astro
# Copia este archivo como '.env' (desarrollo local) o '.env.production' (despliegue en producción) dentro del directorio 'frontend/'.

# URL de la API de FastAPI (Local: http://localhost:8000 | Producción: https://casa-monarca-backend-us-central1.a.run.app)
PUBLIC_API_URL=http://localhost:8000

# Credenciales Públicas de Supabase (Se encuentran en Project Settings -> API)
PUBLIC_SUPABASE_URL=https://tu_proyecto_supabase.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_de_supabase_aqui
