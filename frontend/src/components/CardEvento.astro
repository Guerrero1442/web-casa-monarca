---
interface Props {
  id: string;
  titulo: string;
  fecha_inicio: string;
  lugar: string;
  cupos: number | string;
}

const { id, titulo, fecha_inicio, lugar, cupos } = Astro.props;
---

<div class="card-evento hover:-translate-y-1 transition-all duration-200 ease-in-out hover:border-primary/20">
  <!-- Estado / Diseño Acento -->
  <div class="h-1.5 w-12 rounded-full bg-primary mb-2"></div>
  
  <h3 class="text-xl font-bold text-secondary tracking-tight font-display">
    {titulo}
  </h3>
  
  <!-- Detalles -->
  <div class="flex flex-col gap-1.5 my-3 text-sm text-gray-600">
    <div class="flex items-center gap-2">
      <span class="text-base">📅</span>
      <span>{fecha_inicio}</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-base">📍</span>
      <span class="truncate">{lugar}</span>
    </div>
    <div class="flex items-center gap-2 font-medium">
      <span class="text-base">👥</span>
      <span class="text-primary font-bold">Cupos: {cupos}</span>
    </div>
  </div>

  <div class="mt-auto pt-3 border-t border-gray-50 flex justify-end">
    <button class="btn-primary w-full sm:w-auto text-sm" data-evento-id={id}>
      Inscribirme
    </button>
  </div>
</div>
