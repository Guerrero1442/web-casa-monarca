---
---
<nav class="bg-surface text-secondary border-b border-gray-100 sticky top-0 z-50 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <!-- Logo / Marca -->
        <a href="/" class="flex items-center gap-3 font-bold text-xl tracking-tight hover:opacity-90 transition-opacity">
          <img src="/logo.png" alt="Cangurapp Logo" class="h-10 w-auto object-contain rounded-full border border-primary/20 shadow-sm" />
          <span class="font-display font-extrabold text-2xl text-secondary">Cangurapp</span>
          <span class="text-xs uppercase bg-primary/10 text-primary px-2.5 py-0.5 rounded-full font-semibold hidden sm:inline-block">Cuidado Infantil</span>
        </a>
      </div>
      
      <!-- Navegación Links -->
      <div class="flex items-center gap-6">
        <a href="/solicitud" class="text-sm font-medium hover:text-primary transition-colors py-2 px-1 border-b-2 border-transparent hover:border-primary cursor-pointer">
          Solicitar Cuidado
        </a>
        <!-- Denegado por defecto (clase 'hidden' de Tailwind) -->
        <a href="/admin/dashboard" id="nav-link-admin" class="hidden text-sm font-medium hover:text-primary transition-colors py-2 px-1 border-b-2 border-transparent hover:border-primary cursor-pointer">
          Panel Admin
        </a>
        
        <!-- Botón de Simulación de Perfil / Logout -->
        <div class="flex items-center gap-3 border-l border-gray-200 pl-6">
          <div id="navbar-avatar" class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm uppercase">U</div>
          <button id="btn-navbar-salir" class="text-xs text-gray-500 hover:text-primary transition-colors font-semibold uppercase tracking-wider bg-transparent border-none cursor-pointer focus:outline-none">
            Salir
          </button>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  import { supabase } from '../utils/supabase';

  function parseJwt(token: string) {
    try {
      const base64Url = token.split(".")[1];
      const base64 = base64Url.replace(/-/g, "+").replace(/_/g, "/");
      return JSON.parse(atob(base64));
    } catch {
      return null;
    }
  }

  function inicializarNavbar() {
    const token = localStorage.getItem("token");
    const avatar = document.getElementById("navbar-avatar");
    const btnSalir = document.getElementById("btn-navbar-salir");
    const linkAdmin = document.getElementById("nav-link-admin");

    if (avatar) avatar.innerText = "U";

    if (token) {
      const payload = parseJwt(token);
      if (payload) {
        const email = payload.email || "";
        const nombre = payload.user_metadata?.full_name || payload.user_metadata?.name || email || "U";
        
        const isAdmin = email.toLowerCase().startsWith("admin");
        if (isAdmin && linkAdmin) {
          linkAdmin.classList.remove("hidden");
        }

        const palabras = nombre.trim().split(/\s+/);
        let iniciales = "U";
        if (palabras.length >= 2 && palabras[0] && palabras[1]) {
          iniciales = (palabras[0][0] + palabras[1][0]).toUpperCase();
        } else if (palabras[0]) {
          iniciales = palabras[0].substring(0, 2).toUpperCase();
        }
        if (avatar) avatar.innerText = iniciales;
      }
    }

    btnSalir?.addEventListener("click", async (e) => {
      e.preventDefault();
      localStorage.removeItem("token");
      try {
        await supabase.auth.signOut();
      } catch (err) {
        console.error("Error al cerrar sesión:", err);
      }
      window.location.href = "/";
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", inicializarNavbar);
  } else {
    inicializarNavbar();
  }
</script>
