---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout title="Panel de Administración - Cangurapp">
  <Navbar />
  
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col gap-8">
    
    <!-- Encabezado del Dashboard -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-gray-100 pb-6 text-left">
      <div>
        <h1 class="text-3xl font-extrabold text-secondary tracking-tight font-display">
          Panel de Control - Cuidado Infantil
        </h1>
        <p class="text-gray-500 text-sm mt-1">
          Consolida la demanda de solicitudes de cuidado de menores y publica eventos según los rangos horarios requeridos.
        </p>
      </div>
      <div class="flex gap-3">
        <button id="btn-abrir-crear-evento" class="bg-primary text-white py-2.5 px-5 text-sm font-bold rounded-xl flex items-center gap-1.5 shadow-sm hover:opacity-90 active:scale-95 transition-all">
          <span>➕</span> Crear Evento de Cuidado
        </button>
      </div>
    </div>

    <!-- Sección 1: Consolidado de Solicitudes (Demanda) -->
    <div class="bg-surface border border-gray-100 rounded-2xl p-6 shadow-sm">
      <h2 class="text-xl font-bold text-secondary mb-2 flex items-center gap-2">
        <span>📊</span> Demanda Consolidada de Cuidado
      </h2>
      <p class="text-xs text-gray-500 mb-6">
        Solicitudes de las madres agrupadas por menor, requerimientos médicos y rango horario solicitado.
      </p>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-100 text-left text-sm">
          <thead>
            <tr class="text-gray-400 font-semibold uppercase tracking-wider text-xs">
              <th class="py-3 px-4">Menor</th>
              <th class="py-3 px-4">Alergias / Req. Médicos</th>
              <th class="py-3 px-4">Inicio Requerido</th>
              <th class="py-3 px-4">Fin Requerido</th>
              <th class="py-3 px-4 text-center">Estado</th>
            </tr>
          </thead>
          <tbody id="tabla-solicitudes-body" class="divide-y divide-gray-50 text-gray-700 font-medium">
            <tr>
              <td colspan="5" class="text-center py-6 text-gray-500 animate-pulse">Cargando solicitudes consolidadas...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Sección 2: Eventos Publicados -->
    <div>
      <h2 class="text-xl font-bold text-secondary mb-4 flex items-center gap-2">
        <span>🎪</span> Eventos de Cuidado Publicados
      </h2>
      <div id="eventos-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
        <p class="text-sm text-gray-500 animate-pulse col-span-full">Cargando eventos...</p>
      </div>
    </div>

    <!-- Modal de Creación de Evento -->
    <div id="crear-evento-modal" class="fixed inset-0 z-50 overflow-y-auto hidden items-center justify-center p-4">
      <div class="fixed inset-0 bg-secondary/40 backdrop-blur-sm transition-opacity" id="modal-backdrop"></div>

      <div class="bg-surface rounded-3xl p-6 md:p-8 border border-gray-100 shadow-2xl w-full max-w-lg z-10 relative transform transition-all flex flex-col gap-6 text-left">
        <button id="btn-cerrar-modal" class="absolute top-4 right-4 text-gray-400 hover:text-secondary text-xl font-bold p-1">
          ✕
        </button>
        
        <div>
          <h2 class="text-2xl font-bold text-secondary tracking-tight">
            Crear Evento de Cuidado
          </h2>
          <p class="text-gray-500 text-xs mt-1">
            Define la franja horaria y la capacidad máxima para la atención de los menores.
          </p>
        </div>

        <form id="crear-evento-form" class="flex flex-col gap-4">
          <div>
            <label for="input-titulo" class="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
              Título del Evento
            </label>
            <input 
              type="text" 
              id="input-titulo" 
              placeholder="Ej. Guardería Turno Mañana"
              class="w-full bg-background border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium text-secondary focus:outline-none focus:border-primary" 
              required
            />
          </div>

          <div>
            <label for="input-descripcion" class="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
              Descripción (Opcional)
            </label>
            <textarea 
              id="input-descripcion" 
              placeholder="Detalles sobre actividades o lugar dentro del centro..."
              rows="3"
              class="w-full bg-background border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium text-secondary focus:outline-none focus:border-primary resize-none"
            ></textarea>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="input-inicio-evento" class="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
                Fecha/Hora Inicio
              </label>
              <input 
                type="datetime-local" 
                id="input-inicio-evento" 
                class="w-full bg-background border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium text-secondary focus:outline-none focus:border-primary" 
                required
              />
            </div>
            <div>
              <label for="input-fin-evento" class="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
                Fecha/Hora Fin
              </label>
              <input 
                type="datetime-local" 
                id="input-fin-evento" 
                class="w-full bg-background border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium text-secondary focus:outline-none focus:border-primary" 
                required
              />
            </div>
          </div>

          <div>
            <label for="input-capacidad" class="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
              Capacidad Máxima de Menores (Aforo)
            </label>
            <input 
              type="number" 
              id="input-capacidad" 
              min="1"
              placeholder="15"
              class="w-full bg-background border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium text-secondary focus:outline-none focus:border-primary" 
              required
            />
          </div>

          <button
            type="submit"
            id="btn-guardar-evento"
            class="w-full bg-primary text-white font-bold py-3 rounded-xl text-sm shadow-sm hover:opacity-90 transition-all flex items-center justify-center gap-2"
          >
            <span id="spinner-guardar" class="hidden animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></span>
            <span id="texto-guardar">Crear Evento y Notificar</span>
          </button>
        </form>
      </div>
    </div>

  </main>
</Layout>

<script>
  import { obtenerPerfil, obtenerSolicitudesConsolidadas, obtenerEventos, crearEvento } from '../../utils/api';

  declare const Swal: any;

  function parseJwt(token: string): any {
    try {
      const base64Url = token.split(".")[1];
      const base64 = base64Url.replace(/-/g, "+").replace(/_/g, "/");
      return JSON.parse(atob(base64));
    } catch {
      return null;
    }
  }

  async function inicializarDashboard() {
    const token = localStorage.getItem("token");
    let isAdmin = false;
    if (token) {
      const payload = parseJwt(token);
      const email = payload?.email || "";
      isAdmin = email.toLowerCase().startsWith("admin") || payload?.rol === "admin";
    }

    if (!isAdmin) {
      const main = document.querySelector("main");
      if (main) {
        main.innerHTML = `
          <div class="text-center py-16">
            <h1 class="text-2xl font-bold text-red-600">Acceso Denegado</h1>
            <p class="text-sm text-gray-500 mt-2">Solo los administradores pueden acceder a esta sección.</p>
          </div>
        `;
      }
      setTimeout(() => {
        window.location.href = "/solicitud";
      }, 2000);
      return;
    }

    try {
      await cargarSolicitudesConsolidadas();
      await cargarEventos();
    } catch (err) {
      console.error("Error al cargar dashboard de admin:", err);
    }
  }

  async function cargarSolicitudesConsolidadas() {
    const body = document.getElementById("tabla-solicitudes-body");
    if (!body) return;

    try {
      const solicitudes = await obtenerSolicitudesConsolidadas();
      if (solicitudes.length === 0) {
        body.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-gray-400">No hay solicitudes de cuidado registradas.</td></tr>`;
        return;
      }

      body.innerHTML = solicitudes.map(s => {
        let badgeColor = "bg-amber-100 text-amber-800 border-amber-300";
        if (s.estado === "Parcial") badgeColor = "bg-orange-100 text-orange-800 border-orange-300";
        if (s.estado === "Cubierta") badgeColor = "bg-emerald-100 text-emerald-800 border-emerald-300";

        const inicio = new Date(s.inicio_requerido).toLocaleString();
        const fin = new Date(s.fin_requerido).toLocaleString();
        const menorNombre = s.menor ? s.menor.nombre : "Desconocido";
        const alergias = s.menor?.alergias || "Ninguna";
        const medicos = s.menor?.requerimientos_medicos || "Ninguno";

        return `
          <tr>
            <td class="py-3 px-4 text-secondary font-bold">👶 ${menorNombre}</td>
            <td class="py-3 px-4 text-xs text-gray-600">
              <p><strong>Alergias:</strong> ${alergias}</p>
              <p><strong>Req:</strong> ${medicos}</p>
            </td>
            <td class="py-3 px-4 text-xs text-gray-600">${inicio}</td>
            <td class="py-3 px-4 text-xs text-gray-600">${fin}</td>
            <td class="py-3 px-4 text-center">
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold border ${badgeColor}">
                ${s.estado}
              </span>
            </td>
          </tr>
        `;
      }).join("");
    } catch (err) {
      body.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-red-500">Error al obtener las solicitudes.</td></tr>`;
    }
  }

  async function cargarEventos() {
    const grid = document.getElementById("eventos-grid");
    if (!grid) return;

    try {
      const eventos = await obtenerEventos();
      if (eventos.length === 0) {
        grid.innerHTML = `<p class="text-sm text-gray-500 col-span-full">No se han publicado eventos de cuidado infantil.</p>`;
        return;
      }

      grid.innerHTML = eventos.map(ev => {
        const inicio = new Date(ev.inicio_evento).toLocaleString();
        const fin = new Date(ev.fin_evento).toLocaleString();
        const ocupados = ev.aforo_actual ?? 0;
        const disponibles = ev.cupos_disponibles ?? ev.capacidad_maxima;

        return `
          <div class="bg-surface p-5 rounded-2xl border border-gray-100 shadow-sm space-y-3">
            <div class="flex justify-between items-start">
              <h3 class="font-bold text-secondary text-base">${ev.titulo}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-primary/10 text-primary">
                Aforo: ${ocupados} / ${ev.capacidad_maxima}
              </span>
            </div>
            ${ev.descripcion ? `<p class="text-xs text-gray-500">${ev.descripcion}</p>` : ''}
            <div class="text-xs text-gray-600 space-y-1 pt-2 border-t border-gray-50">
              <p><strong>Inicio:</strong> ${inicio}</p>
              <p><strong>Fin:</strong> ${fin}</p>
              <p class="text-emerald-700 font-semibold mt-1">Disponibles: ${disponibles} cupos</p>
            </div>
          </div>
        `;
      }).join("");
    } catch (err) {
      grid.innerHTML = `<p class="text-sm text-red-500 col-span-full">Error al cargar eventos.</p>`;
    }
  }

  // Controlling Event Creation Modal
  const modal = document.getElementById("crear-evento-modal");
  const btnAbrir = document.getElementById("btn-abrir-crear-evento");
  const btnCerrar = document.getElementById("btn-cerrar-modal");
  const form = document.getElementById("crear-evento-form") as HTMLFormElement;

  btnAbrir?.addEventListener("click", () => modal?.classList.remove("hidden"));
  btnCerrar?.addEventListener("click", () => modal?.classList.add("hidden"));
  document.getElementById("modal-backdrop")?.addEventListener("click", () => modal?.classList.add("hidden"));

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const titulo = (document.getElementById("input-titulo") as HTMLInputElement).value;
    const descripcion = (document.getElementById("input-descripcion") as HTMLTextAreaElement).value;
    const inicioRaw = (document.getElementById("input-inicio-evento") as HTMLInputElement).value;
    const finRaw = (document.getElementById("input-fin-evento") as HTMLInputElement).value;
    const capacidad_maxima = parseInt((document.getElementById("input-capacidad") as HTMLInputElement).value);

    const inicioDate = new Date(inicioRaw);
    const finDate = new Date(finRaw);

    // Client Validation: inicio < fin
    if (inicioDate >= finDate) {
      if (typeof Swal !== "undefined") {
        Swal.fire({ title: "Validación de Horario", text: "La hora de inicio debe ser estrictamente anterior a la de fin.", icon: "warning", confirmButtonColor: "#C36B53" });
      }
      return;
    }

    const btnSubmit = document.getElementById("btn-guardar-evento") as HTMLButtonElement;
    const spinner = document.getElementById("spinner-guardar");
    const texto = document.getElementById("texto-guardar");

    // Asynchronous UI feedback (disable button and show spinner)
    btnSubmit.disabled = true;
    spinner?.classList.remove("hidden");
    if (texto) texto.innerText = "Procesando Notificaciones...";

    try {
      await crearEvento({
        titulo,
        descripcion,
        inicio_evento: inicioDate.toISOString(),
        fin_evento: finDate.toISOString(),
        capacidad_maxima,
      });

      if (typeof Swal !== "undefined") {
        Swal.fire({
          title: "¡Evento Creado!",
          text: "El evento ha sido registrado y las notificaciones asíncronas han sido enviadas a las madres afectadas.",
          icon: "success",
          confirmButtonColor: "#C36B53"
        });
      }

      form.reset();
      modal?.classList.add("hidden");
      await inicializarDashboard();
    } catch (err: any) {
      let msg = "Error al crear el evento.";
      if (err.json) {
        const res = await err.json();
        msg = res.detail || msg;
      }
      if (typeof Swal !== "undefined") {
        Swal.fire({ title: "Error", text: msg, icon: "error", confirmButtonColor: "#C36B53" });
      }
    } finally {
      btnSubmit.disabled = false;
      spinner?.classList.add("hidden");
      if (texto) texto.innerText = "Crear Evento y Notificar";
    }
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", inicializarDashboard);
  } else {
    inicializarDashboard();
  }
</script>
