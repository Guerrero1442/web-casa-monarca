---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout title="Catálogo de Eventos Disponibles">
  <Navbar />
  
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col gap-8">
    
    <!-- Encabezado de Catálogo -->
    <div class="flex flex-col gap-2 border-b border-gray-100 pb-6 text-left">
      <h1 class="text-3xl font-extrabold text-secondary tracking-tight font-display">
        Eventos Disponibles
      </h1>
      <p class="text-gray-500 text-sm">
        Explora las actividades activas y regístrate en los turnos que mejor se acomoden a tu agenda.
      </p>
    </div>

    <!-- Contenedor Dinámico de Tarjetas -->
    <div id="eventos-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div id="eventos-loader" class="col-span-full text-center py-12 text-gray-500">
        <span class="animate-pulse">Cargando eventos disponibles...</span>
      </div>
    </div>

  </main>
</Layout>

<script>
  declare var SwalApp: any;
  import { obtenerEventos, inscribirVoluntario, cancelarInscripcion } from '../../utils/api';

  // Decodificador de JWT ligero
  function parseJwt(token: string) {
    try {
      const base64Url = token.split(".")[1];
      const base64 = base64Url.replace(/-/g, "+").replace(/_/g, "/");
      return JSON.parse(atob(base64));
    } catch {
      return null;
    }
  }

  async function cargarEventos() {
    const container = document.getElementById("eventos-container");
    if (!container) return;

    // Asegurar que el loader se muestre al inicio de la carga
    const loader = document.getElementById("eventos-loader");
    if (loader) {
      loader.classList.remove("hidden");
    }

    const token = localStorage.getItem("token");
    let rol = "voluntario";
    if (token) {
      const payload = parseJwt(token);
      const email = payload?.email || "";
      if (email?.toLowerCase()?.startsWith("admin")) {
        rol = "admin";
      }
    }

    try {
      const eventos = await obtenerEventos();
      
      if (eventos.length === 0) {
        container.innerHTML = `
          <div class="col-span-full text-center py-12 text-gray-500 bg-surface rounded-2xl border border-gray-100 p-6">
            No hay eventos disponibles en este momento.
          </div>
        `;
        return;
      }

      container.innerHTML = eventos.map(evento => {
        // Formatear fecha de inicio en es-MX
        const fecha = new Date(evento.fecha_inicio);
        const fechaFormateada = fecha.toLocaleDateString('es-MX', {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });

        const cerrado = new Date(evento.fecha_inicio) <= new Date();

        return `
          <div class="card-evento hover:-translate-y-1 transition-all duration-200 ease-in-out hover:border-primary/20">
            <div class="h-1.5 w-12 rounded-full bg-primary mb-2"></div>
            
            <h3 class="text-xl font-bold text-secondary tracking-tight font-display">
              ${evento.titulo}
            </h3>
            
            <div class="flex flex-col gap-1.5 my-3 text-sm text-gray-600">
              <div class="flex items-center gap-2">
                <span class="text-base">📅</span>
                <span>${fechaFormateada}</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-base">📍</span>
                <span class="truncate" title="${evento.lugar}">${evento.lugar}</span>
              </div>
              <div class="flex items-center gap-2 font-medium">
                <span class="text-base">👥</span>
                <span class="text-primary font-bold">Cupos Libres: ${evento.cupos_disponibles}</span>
              </div>
            </div>

            <div class="mt-auto pt-3 border-t border-gray-50 flex justify-end">
              ${
                cerrado
                  ? `<button class="w-full sm:w-auto text-sm bg-gray-300 text-gray-500 cursor-not-allowed border-none py-2.5 px-6 rounded-pill font-bold selector-boton-inscripcion" disabled>Evento Cerrado</button>`
                  : evento.usuario_inscrito === true
                    ? `<button class="w-full sm:w-auto text-sm border border-red-600 text-red-600 hover:bg-red-50 py-2.5 px-6 rounded-pill font-bold btn-cancelar selector-boton-inscripcion" data-evento-id="${evento.id}">Cancelar Inscripción</button>`
                    : evento.cupos_disponibles <= 0
                      ? `<button class="w-full sm:w-auto text-sm bg-red-800 text-white cursor-not-allowed py-2.5 px-6 rounded-pill font-bold selector-boton-inscripcion" disabled>Evento Lleno</button>`
                      : `<button class="btn-primary w-full sm:w-auto text-sm btn-inscribir selector-boton-inscripcion" data-evento-id="${evento.id}">Inscribirme</button>`
              }
            </div>
          </div>
        `;
      }).join('');

      // 2. Defensa contra Nulidad (Null Safety) en el DOM para Modo Auditoría
      const tarjetas = container.querySelectorAll(".card-evento");
      tarjetas.forEach(tarjeta => {
        const botonInscripcion = tarjeta.querySelector('.selector-boton-inscripcion') as HTMLButtonElement | null;
        if (botonInscripcion && rol === 'admin') {
          botonInscripcion.innerText = "Modo Auditoría";
          botonInscripcion.disabled = true;
          botonInscripcion.className = "w-full sm:w-auto text-sm bg-gray-400 text-white cursor-not-allowed pointer-events-none py-2.5 px-6 rounded-pill font-bold border-none";
        }
      });

      // Escuchar eventos en los botones de inscribir
      const botones = container.querySelectorAll(".btn-inscribir");
      botones.forEach(boton => {
        boton.addEventListener("click", async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const eventoId = target.getAttribute("data-evento-id");
          if (!eventoId) return;

          // Deshabilitar botón durante el proceso
          target.disabled = true;
          const originalText = target.innerText;
          target.innerText = "Procesando...";

          try {
            await inscribirVoluntario(eventoId);
            SwalApp.fire({
              title: '¡Inscripción Exitosa!',
              text: 'Se ha registrado tu inscripción y agendado el correo de confirmación.',
              icon: 'success',
              timer: 2500,
              showConfirmButton: false
            });
            await cargarEventos();
          } catch (err: any) {
            target.disabled = false;
            target.innerText = originalText;

            if (err instanceof Response) {
              if (err.status === 401) {
                SwalApp.fire({
                  title: 'Sesión expirada',
                  text: 'Tu sesión ha vencido. Redirigiendo...',
                  icon: 'warning',
                  timer: 2000,
                  showConfirmButton: false
                }).then(() => {
                  window.location.href = "/";
                });
              } else if (err.status === 403) {
                const errorData = await err.json().catch(() => ({}));
                const detail = errorData.detail || "";
                if (detail.includes("telefono") || detail.includes("Captura obligatoria")) {
                  SwalApp.fire({
                    title: 'Restricción de Teléfono',
                    text: 'Es obligatorio registrar tu número de teléfono en tu perfil antes de inscribirte.',
                    icon: 'warning'
                  }).then(() => {
                    window.location.href = "/voluntario/perfil";
                  });
                } else {
                  SwalApp.fire({ title: 'Acceso Denegado', text: 'Acceso no autorizado para realizar esta inscripción.', icon: 'error' }).then(() => {
                    window.location.href = "/";
                  });
                }
              } else if (err.status === 400) {
                const errorData = await err.json().catch(() => ({}));
                SwalApp.fire({ title: 'Error de Inscripción', text: errorData.detail || "Sobrecupo o inscripción duplicada.", icon: 'error' });
              } else {
                SwalApp.fire({ title: 'Error de Servidor', text: 'Ha ocurrido un error en el servidor. Intente de nuevo más tarde.', icon: 'error' });
              }
            } else {
              SwalApp.fire({ title: 'Error de Conexión', text: err.message || "Error al conectar con la API.", icon: 'error' });
            }
          }
        });
      });

      // Escuchar eventos en los botones de cancelar inscripción
      const botonesCancelar = container.querySelectorAll(".btn-cancelar");
      botonesCancelar.forEach(boton => {
        boton.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const eventoId = target.getAttribute("data-evento-id");
          if (!eventoId) return;

          SwalApp.fire({
            title: '¿Cancelar Inscripción?',
            text: '¿Estás seguro de que deseas cancelar tu participación en este evento?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, cancelar',
            cancelButtonText: 'No, mantener'
          }).then(async (result: any) => {
            if (result.isConfirmed) {
              target.disabled = true;
              const originalText = target.innerText;
              target.innerText = "Cancelando...";

              try {
                await cancelarInscripcion(eventoId);
                SwalApp.fire({
                  title: 'Cancelación Exitosa',
                  text: 'Tu inscripción ha sido cancelada.',
                  icon: 'success',
                  timer: 2000,
                  showConfirmButton: false
                });
                await cargarEventos();
              } catch (err: any) {
                target.disabled = false;
                target.innerText = originalText;

                if (err instanceof Response) {
                  if (err.status === 401) {
                    SwalApp.fire({
                      title: 'Sesión expirada',
                      text: 'Tu sesión ha vencido. Redirigiendo...',
                      icon: 'warning',
                      timer: 2000,
                      showConfirmButton: false
                    }).then(() => {
                      window.location.href = "/";
                    });
                  } else {
                    const errData = await err.json().catch(() => ({}));
                    SwalApp.fire({ title: 'Error al Cancelar', text: errData.detail || "Error desconocido.", icon: 'error' });
                  }
                } else {
                  SwalApp.fire({ title: 'Error de Conexión', text: err.message || "Error al conectar con la API.", icon: 'error' });
                }
              }
            }
          });
        });
      });

    } catch (err: any) {
      container.innerHTML = `
        <div class="col-span-full text-center py-12 text-red-600 bg-surface rounded-2xl border border-gray-100 p-6">
          Error al conectar con la API. Asegúrese de haber iniciado sesión.
        </div>
      `;
      if (err instanceof Response) {
        if (err.status === 401) {
          window.location.href = "/";
        } else if (err.status === 403) {
          const errorData = await err.json().catch(() => ({}));
          const detail = errorData.detail || "";
          if (detail.includes("telefono") || detail.includes("Captura obligatoria")) {
            SwalApp.fire({
              title: 'Restricción de Teléfono',
              text: 'Es obligatorio registrar tu número de teléfono.',
              icon: 'warning'
            }).then(() => {
              window.location.href = "/voluntario/perfil";
            });
          } else {
            window.location.href = "/";
          }
        }
      }
    } finally {
      // Liberar interfaz en el bloque finally garantizando que el loader siempre se oculte
      const loaderFinal = document.getElementById("eventos-loader");
      if (loaderFinal) {
        loaderFinal.classList.add("hidden");
      }
    }
  }

  // Ejecutar al cargar el DOM del cliente
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", cargarEventos);
  } else {
    cargarEventos();
  }
</script>
