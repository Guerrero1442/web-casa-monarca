---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Cangurapp - Cuidado Infantil", 
	description = "Plataforma de gestión de solicitudes de cuidado infantil con Cangurapp. Cuidamos hoy, construimos mañanas."
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />

		<!-- Google Fonts para tipografía premium -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<!-- SweetAlert2 CDN -->
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" is:inline></script>
	</head>
	<body class="bg-background text-secondary font-sans antialiased min-h-screen">
		<slot />
		
		<!-- SweetAlert2 Tailwind Theme Mixin -->
		<script is:inline>
			window.SwalApp = Swal.mixin({
				customClass: {
					confirmButton: 'bg-[#C36B53] hover:bg-[#b05c47] text-white font-bold py-2.5 px-6 rounded-full mx-2 border-none cursor-pointer text-sm transition-colors shadow-sm',
					cancelButton: 'bg-[#23352F] hover:bg-[#192622] text-white font-bold py-2.5 px-6 rounded-full mx-2 border-none cursor-pointer text-sm transition-colors shadow-sm'
				},
				buttonsStyling: false
			});
		</script>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
